{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "metric_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Metric Refs",
          "type": "array"
        },
        "metric_claims": {
          "additionalProperties": {
            "maxLength": 64,
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "type": "string"
          },
          "description": "Exact numeric claims keyed by exported metric reference, using decimal strings.",
          "maxProperties": 100,
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Metric Claims",
          "type": "object"
        }
      },
      "required": [
        "summary",
        "evidence_refs",
        "metric_refs"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "corrects_review_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^REVIEW-[A-Za-z0-9-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrects Review Id"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "package_id": {
      "maxLength": 120,
      "pattern": "^PKG-[A-Za-z0-9-]+$",
      "title": "Package Id",
      "type": "string"
    },
    "trade_decision_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Trade Decision Id",
      "type": "string"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "review_type": {
      "enum": [
        "PRE_TRADE",
        "IN_TRADE",
        "POST_TRADE",
        "STRATEGY_RESEARCH",
        "LEARNING_REVIEW"
      ],
      "title": "Review Type",
      "type": "string"
    },
    "assessment": {
      "enum": [
        "SUPPORTED",
        "CONDITIONAL",
        "REJECTED",
        "INSUFFICIENT_DATA"
      ],
      "title": "Assessment",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "maxItems": 100,
      "title": "Findings",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Evidence Refs",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Missing Evidence",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Contradictions",
      "type": "array"
    },
    "risk_concerns": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Risk Concerns",
      "type": "array"
    },
    "suggested_actions": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Suggested Actions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "trade_decision_id",
    "plan_version",
    "review_type",
    "assessment",
    "findings",
    "evidence_refs",
    "missing_evidence",
    "contradictions",
    "risk_concerns",
    "suggested_actions",
    "limitations"
  ],
  "title": "TradeForge AI review v1",
  "type": "object"
}
